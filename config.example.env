# Quote/0
export QUOTE0_API_KEY="dot_app_xxx"
export QUOTE0_DEVICE_ID="YOUR_DEVICE_ID"

# Fixed / Loop content slots (optional — only needed when multiple cards exist)
export QUOTE0_IMAGE_TASK_KEY=""
export QUOTE0_TEXT_TASK_KEY=""

# For fixed mode, usually false. For immediate manual display, use true.
export QUOTE0_REFRESH_NOW="false"

# Claude subscription usage
# Reads ~/.claude/.credentials.json by default, override with env var if needed.
# export CLAUDE_ACCESS_TOKEN=""

# DeepSeek 余额与峰谷计费展示
export DEEPSEEK_API_KEY="sk-xxx"
# 计价模型：deepseek-v4-flash / deepseek-v4-pro / deepseek-v4-flash-vision-exp
export DEEPSEEK_MODEL="deepseek-v4-flash"

# OpenCode Go（OpenCode Zen "Go" 订阅）
# 用量 API: GET https://opencode.ai/zen/go/v1/usage（Bearer key）
# export OPENCODE_GO_API_KEY="oc_xxx"

# 第二面板：auto（优先 opencode-go，回退 deepseek）| deepseek | opencode
export SECOND_PANEL="auto"

# 布局：auto（按已配置 provider 数自适应）| stack（默认全宽堆叠）| 1+1 | 1+2（上1半+下2格）| 2+2
# export LAYOUT="auto"

# Codex auth (reads ~/.codex/auth.json by default, override with env var)
# export CODEX_ACCESS_TOKEN=""
# export CODEX_ACCOUNT_ID=""

# Preview output
export QUOTE0_PREVIEW_PATH="/tmp/quote0_burnout_preview.png"
